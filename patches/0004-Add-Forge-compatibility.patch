diff --git a/proxy/src/main/java/net/md_5/bungee/ForgeHandshake.java b/proxy/src/main/java/net/md_5/bungee/ForgeHandshake.java
new file mode 100644
index 0000000..5eb7133
--- /dev/null
+++ b/proxy/src/main/java/net/md_5/bungee/ForgeHandshake.java
@@ -0,0 +1,97 @@
+package net.md_5.bungee;
+
+import java.io.ByteArrayInputStream;
+import java.io.DataInputStream;
+import java.io.IOException;
+import java.util.HashSet;
+import java.util.Set;
+import lombok.Data;
+import net.md_5.bungee.api.ProxyServer;
+import net.md_5.bungee.protocol.packet.PacketFAPluginMessage;
+
+/**
+ * Handshake FML (Forge 1.6.4) géré par le proxy.
+ * 1re connexion : demande de mods relayée au client, réponse mise en cache.
+ * Switch : réponse du cache si demande identique, sinon kick « Mod mismatch ».
+ * Debug : -Ddeltaproxy.debugFml=true
+ */
+public final class ForgeHandshake
+{
+
+    public static final String CHANNEL = "FML";
+    // Types de paquets FML 1.6.4
+    public static final int MOD_LIST_REQUEST = 0;
+    public static final int MOD_LIST_RESPONSE = 1;
+    public static final int MOD_IDENTIFIERS = 2;
+    public static final int MOD_MISSING = 3;
+    /*========================================================================*/
+    private static final boolean DEBUG = Boolean.getBoolean( "deltaproxy.debugFml" );
+    private static final int DEBUG_MAX_BYTES = 256;
+    private static final char[] HEX = "0123456789abcdef".toCharArray();
+
+    private ForgeHandshake()
+    {
+    }
+
+    // Type FML du message, -1 si ce n'est pas du FML
+    public static int getType(PacketFAPluginMessage message)
+    {
+        if ( !CHANNEL.equals( message.getTag() ) || message.getData() == null || message.getData().length == 0 )
+        {
+            return -1;
+        }
+        return message.getData()[0] & 0xFF;
+    }
+
+    public static boolean isType(PacketFAPluginMessage message, int type)
+    {
+        return getType( message ) == type;
+    }
+
+    // Lit une demande de mods : type, nombre, ids, niveau de compat
+    public static ModListRequest parseRequest(byte[] data) throws IOException
+    {
+        DataInputStream in = new DataInputStream( new ByteArrayInputStream( data ) );
+        in.readUnsignedByte(); // type
+        int count = in.readInt();
+        Set<String> mods = new HashSet<>();
+        for ( int i = 0; i < count; i++ )
+        {
+            mods.add( in.readUTF() );
+        }
+        byte compatibilityLevel = in.readByte();
+        return new ModListRequest( mods, compatibilityLevel );
+    }
+
+    // Log hexa des messages FML si debug actif
+    public static void debug(Object who, String direction, PacketFAPluginMessage message)
+    {
+        if ( !DEBUG || !CHANNEL.equals( message.getTag() ) )
+        {
+            return;
+        }
+        byte[] data = message.getData();
+        int len = ( data == null ) ? 0 : data.length;
+        StringBuilder sb = new StringBuilder();
+        sb.append( "[FML] " ).append( who ).append( ' ' ).append( direction );
+        sb.append( " type=" ).append( getType( message ) ).append( " len=" ).append( len ).append( " data=" );
+        for ( int i = 0; i < Math.min( len, DEBUG_MAX_BYTES ); i++ )
+        {
+            sb.append( HEX[( data[i] >> 4 ) & 0xF] ).append( HEX[data[i] & 0xF] );
+        }
+        if ( len > DEBUG_MAX_BYTES )
+        {
+            sb.append( "..." );
+        }
+        ProxyServer.getInstance().getLogger().info( sb.toString() );
+    }
+
+    // Demande de mods, ordre ignoré à la comparaison
+    @Data
+    public static final class ModListRequest
+    {
+
+        private final Set<String> mods;
+        private final byte compatibilityLevel;
+    }
+}
