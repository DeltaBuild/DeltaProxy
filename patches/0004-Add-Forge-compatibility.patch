-            }
+            ch.write( message );
         }
 
         if ( user.getSettings() != null )
@@ -281,30 +289,81 @@ public class ServerConnector extends PacketHandler
             throw new IllegalStateException( "May not connect to another BungeCord!" );
         }
 
-        DataInput in = pluginMessage.getStream();
-        if ( pluginMessage.getTag().equals( "FML" ) && in.readUnsignedByte() == 0 )
+        ForgeHandshake.debug( this, "server -> proxy", pluginMessage );
+
+        int fmlType = ForgeHandshake.getType( pluginMessage );
+        if ( fmlType == ForgeHandshake.MOD_LIST_REQUEST )
         {
-            int count = in.readInt();
-            for ( int i = 0; i < count; i++ )
-            {
-                in.readUTF();
-            }
-            if ( in.readByte() != 0 )
-            {
