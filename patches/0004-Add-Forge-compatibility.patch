-                ch.getHandle().pipeline().get( PacketDecoder.class ).setProtocol( Forge.getInstance() );
-            }
+            handleModListRequest( pluginMessage );
+            return;
+        }
+        if ( fmlType == ForgeHandshake.MOD_MISSING && user.getPendingConnection().getForgeLogin() != null && user.getServer() != null )
+        {
+            // Switch : le serveur refuse la réponse en cache
+            disconnectModMismatch( "server rejected the cached mod list" );
+            return;
         }
 
         user.unsafe().sendPacket( pluginMessage ); // We have to forward these to the user, especially with Forge as stuff might break
-        if ( !sentMessages && user.getPendingConnection().getForgeLogin() != null )
+    }
+
+    // Demande de mods envoyée par le serveur
+    private void handleModListRequest(PacketFAPluginMessage request) throws Exception
+    {
+        ForgeHandshake.ModListRequest parsed = ForgeHandshake.parseRequest( request.getData() );
+        if ( parsed.getCompatibilityLevel() != 0 )
         {
-            for ( PacketFAPluginMessage message : user.getPendingConnection().getLoginMessages() )
-            {
-                ch.write( message );
-            }
-            sentMessages = true;
+            // TODO: Using forge flag
+            ch.getHandle().pipeline().get( PacketDecoder.class ).setProtocol( Forge.getInstance() );
+        }
+
+        // Client vanilla : on transmet
+        if ( user.getPendingConnection().getForgeLogin() == null )
+        {
+            user.unsafe().sendPacket( request );
+            return;
+        }
+
+        byte[] cachedResponse = user.getForgeModListResponse();
+        if ( cachedResponse == null )
+        {
+            // 1re connexion : relais au client, réponse via UpstreamBridge
+            relayedModListRequest = parsed;
+            user.setPendingForgeHandshake( this );
+            user.unsafe().sendPacket( request );
+            return;
         }
+
+        // Switch : réponse du cache si demande identique
+        if ( parsed.equals( user.getForgeModListRequest() ) )
+        {
+            ch.write( new PacketFAPluginMessage( ForgeHandshake.CHANNEL, cachedResponse ) );
+        } else
+        {
+            disconnectModMismatch( "mod list request differs from the cached one" );
+        }
+    }
+
+    // Réponse du client : mise en cache puis envoi au serveur
+    public void forwardClientModListResponse(PacketFAPluginMessage response)
+    {
+        if ( relayedModListRequest == null )
+        {
+            return;
+        }
+        user.setForgeModListRequest( relayedModListRequest );
+        user.setForgeModListResponse( response.getData() );
+        ch.write( response );
+    }
+
+    private void disconnectModMismatch(String detail)
+    {
+        bungee.getLogger().log( Level.WARNING, "{0} Forge mod mismatch: {1}", new Object[]
+        {
+            this, detail
+        } );
+        user.disconnect( bungee.getTranslation( "forge_mod_mismatch" ) );
+        ch.close();
     }
 
     @Override
