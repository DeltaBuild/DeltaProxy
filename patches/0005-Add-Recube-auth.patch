diff --git a/proxy/src/main/java/net/md_5/bungee/http/RecubeAuth.java b/proxy/src/main/java/net/md_5/bungee/http/RecubeAuth.java
new file mode 100644
index 0000000..ea5c7de
--- /dev/null
+++ b/proxy/src/main/java/net/md_5/bungee/http/RecubeAuth.java
@@ -0,0 +1,173 @@
+package net.md_5.bungee.http;
+
+import com.google.common.util.concurrent.ThreadFactoryBuilder;
+import com.google.gson.JsonElement;
+import com.google.gson.JsonObject;
+import com.google.gson.JsonParser;
+import io.netty.channel.EventLoop;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.UnsupportedEncodingException;
+import java.net.URL;
+import java.net.URLEncoder;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.RejectedExecutionException;
+import javax.net.ssl.HttpsURLConnection;
+import javax.net.ssl.SSLContext;
+import lombok.Data;
+import net.md_5.bungee.api.Callback;
+
+/**
+ * Authentification Recube : vérification has-joined entre le client et le proxy.
+ * Appel HTTPS en TLS 1.2 avec vérification du certificat, hors boucle réseau.
+ * Le résultat est renvoyé sur la boucle réseau du joueur.
+ */
+public final class RecubeAuth
+{
+
+    // URL de base et tenant Recube
+    private static final String BASE_URL = "https://recube.gg";
+    private static final String TENANT = "nationsglory";
+    // Délais de connexion et de lecture
+    private static final int CONNECT_TIMEOUT_MS = 5000;
+    private static final int READ_TIMEOUT_MS = 8000;
+    // Taille max de la réponse lue
+    private static final int MAX_BODY_BYTES = 16384;
+    // Threads dédiés aux appels Recube
+    private static final ExecutorService EXECUTOR = Executors.newCachedThreadPool( new ThreadFactoryBuilder().setNameFormat( "Recube Auth #%1$d" ).setDaemon( true ).build() );
+
+    private RecubeAuth()
+    {
+    }
+
+    // Lance la vérification has-joined, résultat sur la boucle réseau
+    public static void hasJoined(final String username, final String serverHash, final String ip, final EventLoop eventLoop, final Callback<Result> callback)
+    {
+        EXECUTOR.execute( new Runnable()
+        {
+            @Override
+            public void run()
+            {
+                Result result = null;
+                Throwable error = null;
+                try
+                {
+                    result = request( username, serverHash, ip );
+                } catch ( Throwable t )
+                {
+                    error = t;
+                }
+
+                final Result finalResult = result;
+                final Throwable finalError = error;
+                try
+                {
+                    eventLoop.execute( new Runnable()
+                    {
+                        @Override
+                        public void run()
+                        {
+                            callback.done( finalResult, finalError );
+                        }
+                    } );
+                } catch ( RejectedExecutionException ex )
+                {
+                    // Boucle réseau arrêtée, le joueur est déjà parti
+                }
+            }
+        } );
+    }
+
+    // Appel GET has-joined
+    private static Result request(String username, String serverHash, String ip) throws Exception
+    {
+        String url = BASE_URL + "/api/game-auth/" + TENANT + "/has-joined?username=" + enc( username ) + "&serverId=" + enc( serverHash );
+        if ( ip != null && !ip.isEmpty() )
+        {
+            url += "&ip=" + enc( ip );
+        }
+
+        HttpsURLConnection conn = (HttpsURLConnection) new URL( url ).openConnection();
+        try
+        {
+            SSLContext tls = SSLContext.getInstance( "TLSv1.2" );
+            tls.init( null, null, null );
+            conn.setSSLSocketFactory( tls.getSocketFactory() );
+            conn.setConnectTimeout( CONNECT_TIMEOUT_MS );
+            conn.setReadTimeout( READ_TIMEOUT_MS );
+            conn.setUseCaches( false );
+            conn.setInstanceFollowRedirects( false );
+            conn.setRequestMethod( "GET" );
+            conn.setRequestProperty( "Accept", "application/json" );
+            conn.setRequestProperty( "User-Agent", "DeltaProxy" );
+
+            int status = conn.getResponseCode();
+            if ( status != 200 )
+            {
+                return new Result( false, status, null, null );
+            }
+
+            JsonElement json = new JsonParser().parse( readBody( conn.getInputStream() ) );
+            if ( !json.isJsonObject() )
+            {
+                return new Result( false, status, null, null );
+            }
+            JsonObject obj = json.getAsJsonObject();
+            String id = stringOf( obj, "id" );
+            if ( id == null || id.isEmpty() )
+            {
+                return new Result( false, status, null, null );
+            }
+            return new Result( true, status, id, stringOf( obj, "name" ) );
+        } finally
+        {
+            conn.disconnect();
+        }
+    }
+
+    private static String readBody(InputStream in) throws IOException
+    {
+        try
+        {
+            ByteArrayOutputStream out = new ByteArrayOutputStream();
+            byte[] buf = new byte[ 4096 ];
+            int n;
+            while ( ( n = in.read( buf ) ) != -1 )
+            {
+                out.write( buf, 0, n );
+                if ( out.size() > MAX_BODY_BYTES )
+                {
+                    throw new IOException( "Recube response too large" );
+                }
+            }
+            return new String( out.toByteArray(), "UTF-8" );
+        } finally
+        {
+            in.close();
+        }
+    }
+
+    private static String stringOf(JsonObject obj, String key)
+    {
+        JsonElement e = obj.get( key );
+        return ( e == null || !e.isJsonPrimitive() ) ? null : e.getAsString();
+    }
+
+    private static String enc(String s) throws UnsupportedEncodingException
+    {
+        return URLEncoder.encode( s, "UTF-8" );
+    }
+
+    // Résultat has-joined : authenticated=false si Recube refuse
+    @Data
+    public static final class Result
+    {
+
+        private final boolean authenticated;
+        private final int status;
+        private final String runtimeId;
+        private final String name;
+    }
+}
